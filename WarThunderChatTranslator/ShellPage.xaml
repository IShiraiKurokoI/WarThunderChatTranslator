<Page
    x:Class="WarThunderChatTranslator.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WarThunderChatTranslator.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <NavigationView
            x:Name="navigationView"
            CompactPaneLength="65"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavigationView_ItemInvoked"
            OpenPaneLength="240">

            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
            </NavigationView.Resources>

            <NavigationView.MenuItems>

                <!-- Core translation features -->
                <NavigationViewItem
                    Margin="0,0,12,0"
                    Content="{helpers:Loc Key=NavApi}"
                    IsSelected="True"
                    Tag="APIPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Margin="0,0,12,0"
                    Content="{helpers:Loc Key=NavAiTranslation}"
                    Tag="AITranslationPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Character" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Margin="0,0,12,0"
                    Content="{helpers:Loc Key=NavQuickVoiceTranslation}"
                    Tag="InteractPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Microphone" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <!-- Application settings -->
                <NavigationViewItem
                    Margin="0,0,12,0"
                    Content="{helpers:Loc Key=NavRunSettings}"
                    Tag="RunSettingsPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Margin="0,0,12,0"
                    Content="{helpers:Loc Key=NavNetwork}"
                    Tag="NetworkPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Margin="0,0,12,0" Content="{helpers:Loc Key=NavAppearance}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
                            Margin="0,0,12,0"
                            Content="{helpers:Loc Key=NavTheme}"
                            Tag="ThemePage">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="FontColor" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>

                        <NavigationViewItem
                            Margin="0,0,12,0"
                            Content="{helpers:Loc Key=NavFont}"
                            Tag="FontPage">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Message" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>

                        <NavigationViewItem
                            Margin="0,0,12,0"
                            Content="{helpers:Loc Key=NavLayout}"
                            Tag="LocationPage">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="FullScreen" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <!-- Maintenance -->
                <NavigationViewItem
                    Margin="0,0,12,0"
                    Content="{helpers:Loc Key=NavUpdate}"
                    Tag="UpdatePage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sync" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="{helpers:Loc Key=NavAbout}" Tag="AboutPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="shellFrame" Background="Transparent" />
        </NavigationView>
    </Grid>
</Page>
