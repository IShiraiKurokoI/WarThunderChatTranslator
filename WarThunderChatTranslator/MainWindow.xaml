<Window
    x:Class="WarThunderChatTranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WarThunderChatTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wuc="using:WinUICommunity"
    mc:Ignorable="d">
    <Grid Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <wuc:TitleBar
            x:Name="appTitleBar"
            Title="战争雷霆聊天翻译器设置界面"
            Height="40"
            VerticalAlignment="Top"
            IsBackButtonVisible="False"
            IsDoubleTapEnabled="False"
            IsMaximizable="False"
            IsPaneButtonVisible="False">
            <wuc:TitleBar.Icon>
                <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/favicon.ico" />
            </wuc:TitleBar.Icon>
        </wuc:TitleBar>
        <local:ShellPage Grid.Row="2" />
    </Grid>
</Window>
