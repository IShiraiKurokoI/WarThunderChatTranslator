<Page
    x:Class="WarThunderChatTranslator.Pages.AITranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WarThunderChatTranslator.Helpers"
    xmlns:labs="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="AiProviderActionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,44,0,0"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{helpers:Loc Key=AiPageTitle}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="0,0,20,48" Spacing="16">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=AiPageDescription}"
                    TextWrapping="Wrap" />

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=AiAddDescription}"
                    Header="{helpers:Loc Key=AiConnectionsTitle}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE710;" />
                    </labs:SettingsCard.HeaderIcon>
                    <Button Click="AddProvider_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="{helpers:Loc Key=AiAddProvider}" />
                        </StackPanel>
                    </Button>
                </labs:SettingsCard>

                <Border
                    x:Name="EmptyState"
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE74C;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{helpers:Loc Key=AiEmptyTitle}" />
                        <TextBlock
                            MaxWidth="640"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{helpers:Loc Key=AiEmptyDescription}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ListView
                    x:Name="ProvidersList"
                    ItemsSource="{x:Bind Providers, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="18,18,10,18"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="7">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                            <Border
                                                Padding="8,2"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding ApiTypeDisplay}" />
                                            </Border>
                                            <Border
                                                Padding="8,2"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="10"
                                                Visibility="{Binding SelectedVisibility}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{helpers:Loc Key=AiSelected}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ModelLine}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding EndpointLine}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding TemperatureLine}"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{Binding PromptLine}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        MinWidth="104"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <Button
                                            Style="{StaticResource AiProviderActionButtonStyle}"
                                            Click="SelectProvider_Click"
                                            IsEnabled="{Binding CanSelect}"
                                            Tag="{Binding Id}"
                                            ToolTipService.ToolTip="{helpers:Loc Key=AiUse}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="16" Glyph="&#xE73E;" />
                                                <TextBlock Text="{helpers:Loc Key=AiUse}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource AiProviderActionButtonStyle}"
                                            Click="TestProvider_Click"
                                            Tag="{Binding Id}"
                                            ToolTipService.ToolTip="{helpers:Loc Key=AiTest}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                                                <TextBlock Text="{helpers:Loc Key=AiTest}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource AiProviderActionButtonStyle}"
                                            Click="EditProvider_Click"
                                            Tag="{Binding Id}"
                                            ToolTipService.ToolTip="{helpers:Loc Key=AiEdit}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                                <TextBlock Text="{helpers:Loc Key=AiEdit}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Style="{StaticResource AiProviderActionButtonStyle}"
                                            Click="DeleteProvider_Click"
                                            Tag="{Binding Id}"
                                            ToolTipService.ToolTip="{helpers:Loc Key=AiDelete}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                                <TextBlock Text="{helpers:Loc Key=AiDelete}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
