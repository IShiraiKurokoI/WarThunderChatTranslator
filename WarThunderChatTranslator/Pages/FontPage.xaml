<Page
    x:Class="WarThunderChatTranslator.Pages.FontPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WarThunderChatTranslator.Helpers"
    xmlns:labs="using:DevWinUI"
    xmlns:local="using:WarThunderChatTranslator.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="20,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Header"
            Margin="0,44,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{helpers:Loc Key=FontTitle}" />

        <ScrollViewer Grid.Row="1">
            <Grid Padding="0,0,20,0" RowSpacing="0">
                <ContentPresenter
                    x:Name="ModuleContentPresenter"
                    Grid.Row="1"
                    Margin="0,0,0,0">
                    <ContentPresenter.Content>
                        <StackPanel>
                            <labs:SettingsCard MaxWidth="2000" Header="{helpers:Loc Key=FontFamily}">
                                <labs:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xe8d2;" />
                                </labs:SettingsCard.HeaderIcon>
                                <ComboBox
                                    x:Name="FontFamilyPanel"
                                    DisplayMemberPath="Item1"
                                    ItemsSource="{x:Bind Fonts}"
                                    SelectedValuePath="Item2"
                                    SelectionChanged="FontFamilyPanel_SelectionChanged" />
                            </labs:SettingsCard>
                            <labs:SettingsCard MaxWidth="2000" Header="{helpers:Loc Key=FontSize}">
                                <labs:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xe8e9;" />
                                </labs:SettingsCard.HeaderIcon>
                                <NumberBox
                                    x:Name="FontSizePanel"
                                    LargeChange="10"
                                    Minimum="1"
                                    SmallChange="2"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="FontSizePanel_TextChanged" />
                            </labs:SettingsCard>
                            <labs:SettingsCard MaxWidth="2000" Header="{helpers:Loc Key=FontStyle}">
                                <labs:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xe8dd;" />
                                </labs:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="FontStylePanel" SelectionChanged="FontStylePanel_SelectionChanged">
                                    <ComboBoxItem Tag="lighter" Content="{helpers:Loc Key=FontLighter}" />
                                    <ComboBoxItem Tag="normal" Content="{helpers:Loc Key=FontNormal}" />
                                    <ComboBoxItem Tag="bold" Content="{helpers:Loc Key=FontBold}" />
                                    <ComboBoxItem Tag="bolder" Content="{helpers:Loc Key=FontBolder}" />
                                </ComboBox>
                            </labs:SettingsCard>
                            <labs:SettingsCard MaxWidth="2000" Header="{helpers:Loc Key=FontAllyColor}">
                                <labs:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xe8d3;" />
                                </labs:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle
                                        x:Name="AllyColorPreview"
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,10,0"
                                        Fill="{x:Bind AllyPreviewBrush, Mode=TwoWay}" />
                                    <Button Click="Ally_Button_Click" Content="{helpers:Loc Key=SelectColor}" />
                                </StackPanel>
                            </labs:SettingsCard>
                            <labs:SettingsCard MaxWidth="2000" Header="{helpers:Loc Key=FontEnemyColor}">
                                <labs:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xe8d3;" />
                                </labs:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle
                                        x:Name="EnemyColorPreview"
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,10,0"
                                        Fill="{x:Bind EnemyPreviewBrush, Mode=TwoWay}" />
                                    <Button Click="Enemy_Button_Click" Content="{helpers:Loc Key=SelectColor}" />
                                </StackPanel>
                            </labs:SettingsCard>
                            <labs:SettingsCard MaxWidth="2000" Header="{helpers:Loc Key=FontSystemColor}">
                                <labs:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xe8d3;" />
                                </labs:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle
                                        x:Name="SystemColorPreview"
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,10,0"
                                        Fill="{x:Bind SystemPreviewBrush, Mode=TwoWay}" />
                                    <Button Click="System_Button_Click" Content="{helpers:Loc Key=SelectColor}" />
                                </StackPanel>
                            </labs:SettingsCard>
                        </StackPanel>
                    </ContentPresenter.Content>
                </ContentPresenter>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
