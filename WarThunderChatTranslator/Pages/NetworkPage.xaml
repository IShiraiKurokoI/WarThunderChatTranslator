<Page
    x:Class="WarThunderChatTranslator.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevWinUI"
    xmlns:converters="using:WarThunderChatTranslator.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WarThunderChatTranslator.Helpers"
    xmlns:local="using:WarThunderChatTranslator.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:NullBoolConverter x:Key="NullBoolConverter" />
    </Page.Resources>
    <Grid Padding="20,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Header"
            Margin="0,44,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{helpers:Loc Key=NetworkTitle}" />

        <ScrollViewer Grid.Row="1">
            <Grid Padding="0,0,20,48" RowSpacing="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Top panel  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            x:Name="AboutDescription"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{helpers:Loc Key=NetworkDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  Content panel  -->
                <ContentPresenter
                    x:Name="ModuleContentPresenter"
                    Grid.Row="1"
                    Margin="0,8,0,0">
                    <ContentPresenter.Content>
                        <StackPanel>
                            <TextBlock FontSize="20" Text="{helpers:Loc Key=ProxyMode}" />
                            <StackPanel x:Name="ProxyPanel" Margin="0,10,0,10">
                                <RadioButton
                                    Checked="RadioButton_Checked"
                                    Content="{helpers:Loc Key=ProxyDefault}"
                                    Tag="Default" />
                                <RadioButton
                                    Checked="RadioButton_Checked"
                                    Content="{helpers:Loc Key=ProxySystem}"
                                    Tag="System" />
                                <RadioButton
                                    x:Name="CustomProxy"
                                    Checked="RadioButton_Checked"
                                    Content="{helpers:Loc Key=ProxyCustom}"
                                    Tag="Custom" />
                            </StackPanel>
                            <TextBlock
                                FontSize="20"
                                Text="{helpers:Loc Key=ProxyCustomSettings}"
                                Visibility="{Binding IsChecked, ElementName=CustomProxy, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <StackPanel
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding IsChecked, ElementName=CustomProxy, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBox
                                    x:Name="ProxyAddress"
                                    Width="180"
                                    Header="{helpers:Loc Key=ProxyAddress}"
                                    PlaceholderText="{helpers:Loc Key=ProxyAddressPlaceholder}"
                                    TextChanged="ProxyAddress_TextChanged" />
                                <TextBox
                                    x:Name="ProxyAccount"
                                    Margin="20,0,0,0"
                                    Header="{helpers:Loc Key=ProxyAccount}"
                                    InputScope="Number"
                                    PlaceholderText="{helpers:Loc Key=ProxyAccountPlaceholder}"
                                    TextChanged="ProxyAccount_TextChanged" />
                                <TextBox
                                    x:Name="ProxyPassword"
                                    Margin="20,0,0,0"
                                    Header="{helpers:Loc Key=ProxyPassword}"
                                    InputScope="Number"
                                    PlaceholderText="{helpers:Loc Key=ProxyPasswordPlaceholder}"
                                    TextChanged="ProxyPassword_TextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </ContentPresenter.Content>
                </ContentPresenter>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
