<Page
    x:Class="WarThunderChatTranslator.Pages.ChatTtsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WarThunderChatTranslator.Helpers"
    xmlns:labs="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="GptSoVitsActionButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,44,0,0"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{helpers:Loc Key=ChatTtsTitle}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="0,0,20,48" Spacing="0">
                <TextBlock
                    Margin="0,0,0,14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=ChatTtsDescription}"
                    TextWrapping="Wrap" />

                <InfoBar
                    x:Name="ChatTtsInfoBar"
                    Margin="0,0,0,12"
                    IsClosable="True"
                    IsOpen="False" />

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=ChatTtsEnableDescription}"
                    Header="{helpers:Loc Key=ChatTtsEnable}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE767;" />
                    </labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ChatTtsEnabled" Toggled="ChatTtsEnabled_Toggled" />
                </labs:SettingsCard>

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=ChatTtsProviderDescription}"
                    Header="{helpers:Loc Key=ChatTtsProvider}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" />
                    </labs:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ChatTtsProvider"
                        Width="420"
                        HorizontalAlignment="Right"
                        SelectionChanged="ChatTtsProvider_SelectionChanged">
                        <ComboBoxItem Content="{helpers:Loc Key=ChatTtsProviderWindows}" Tag="Windows" />
                        <ComboBoxItem Content="{helpers:Loc Key=ChatTtsProviderSherpa}" Tag="SherpaOnnx" />
                        <ComboBoxItem Content="{helpers:Loc Key=ChatTtsProviderGptSoVits}" Tag="GptSoVits" />
                    </ComboBox>
                </labs:SettingsCard>

                <labs:SettingsCard
                    MaxWidth="2000"
                    HorizontalContentAlignment="Stretch"
                    Description="{helpers:Loc Key=ChatTtsOutputDeviceDescription}"
                    Header="{helpers:Loc Key=ChatTtsOutputDevice}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F5;" />
                    </labs:SettingsCard.HeaderIcon>
                    <Grid Width="420" HorizontalAlignment="Right" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ChatTtsOutputDevice"
                            Grid.Column="0"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ChatTtsOutputDevice_SelectionChanged" />
                        <Button
                            Grid.Column="1"
                            Click="RefreshTtsOutputDevices_Click"
                            ToolTipService.ToolTip="{helpers:Loc Key=ChatTtsRefreshOutputDevices}">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                    </Grid>
                </labs:SettingsCard>

                <StackPanel x:Name="SherpaSettingsSection" Visibility="Collapsed">
                    <TextBlock
                        Margin="0,24,0,8"
                        FontSize="20"
                        Text="{helpers:Loc Key=ChatTtsLocalModelSettings}" />

                    <labs:SettingsCard
                        MaxWidth="2000"
                        HorizontalContentAlignment="Stretch"
                        Description="{helpers:Loc Key=ChatTtsModelStateDescription}"
                        Header="{helpers:Loc Key=ChatTtsModelState}">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </labs:SettingsCard.HeaderIcon>
                        <StackPanel
                            MaxWidth="700"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    x:Name="SherpaModelStateText"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    TextAlignment="Right" />
                                <Button
                                    x:Name="SherpaModelInfoButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="SherpaModelInfoButton_Click"
                                    ToolTipService.ToolTip="{helpers:Loc Key=ChatTtsModelInfoToolTip}">
                                    <FontIcon FontSize="14" Glyph="&#xE946;" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                x:Name="SherpaModelStateDetail"
                                HorizontalAlignment="Stretch"
                                Opacity="0.65"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </labs:SettingsCard>


                    <labs:SettingsCard
                        MaxWidth="2000"
                        Description="{helpers:Loc Key=ChatTtsSherpaThreadsDescription}"
                        Header="{helpers:Loc Key=ChatTtsSherpaThreads}">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE950;" />
                        </labs:SettingsCard.HeaderIcon>
                        <NumberBox
                            x:Name="SherpaThreads"
                            Width="420"
                            HorizontalAlignment="Right"
                            Maximum="16"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="SherpaThreads_ValueChanged" />
                    </labs:SettingsCard>
                </StackPanel>

                <StackPanel x:Name="GptSoVitsSettingsSection" Visibility="Collapsed">
                    <TextBlock
                        Margin="0,24,0,8"
                        FontSize="20"
                        Text="{helpers:Loc Key=ChatTtsGptSoVitsSettings}" />

                    <labs:SettingsCard
                        MaxWidth="2000"
                        Description="{helpers:Loc Key=ChatTtsGptSoVitsApiDescription}"
                        Header="{helpers:Loc Key=ChatTtsGptSoVitsApi}">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE774;" />
                        </labs:SettingsCard.HeaderIcon>
                        <TextBox
                            x:Name="GptSoVitsApiUrl"
                            Width="420"
                            HorizontalAlignment="Right"
                            TextChanged="GptSoVitsApiUrl_TextChanged" />
                    </labs:SettingsCard>

                    <labs:SettingsCard
                        MaxWidth="2000"
                        HorizontalContentAlignment="Stretch"
                        Description="{helpers:Loc Key=ChatTtsGptSoVitsStatusDescription}"
                        Header="{helpers:Loc Key=ChatTtsGptSoVitsStatus}">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </labs:SettingsCard.HeaderIcon>
                        <Grid Width="420" HorizontalAlignment="Right">
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    x:Name="GptSoVitsStatusText"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <Button
                                    x:Name="GptSoVitsCheckButton"
                                    Margin="12,0,0,0"
                                    Click="GptSoVitsCheckButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" />
                                        <TextBlock Text="{helpers:Loc Key=ChatTtsGptSoVitsCheck}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="GptSoVitsInfoButton_Click"
                                    ToolTipService.ToolTip="{helpers:Loc Key=ChatTtsGptSoVitsInfo}">
                                    <FontIcon FontSize="14" Glyph="&#xE946;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </labs:SettingsCard>

                    <labs:SettingsCard
                        MaxWidth="2000"
                        Description="{helpers:Loc Key=ChatTtsGptSoVitsProfilesDescription}"
                        Header="{helpers:Loc Key=ChatTtsGptSoVitsProfiles}">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </labs:SettingsCard.HeaderIcon>
                        <Button Click="GptSoVitsAddProfileButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock Text="{helpers:Loc Key=ChatTtsGptSoVitsAddProfile}" />
                            </StackPanel>
                        </Button>
                    </labs:SettingsCard>

                    <Border
                        x:Name="GptSoVitsProfilesEmptyState"
                        Margin="0,0,0,12"
                        Padding="24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE77B;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{helpers:Loc Key=ChatTtsGptSoVitsProfiles}" />
                            <TextBlock
                                MaxWidth="640"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{helpers:Loc Key=ChatTtsGptSoVitsProfilesDescription}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ListView
                        x:Name="GptSoVitsProfilesList"
                        Margin="0,0,0,12"
                        SelectionMode="None"
                        Visibility="Collapsed">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="18,18,10,18"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}" />
                                                <Border
                                                    Padding="8,2"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{Binding SelectedVisibility}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="{helpers:Loc Key=AiSelected}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ModelLine}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ReferenceLine}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{Binding PromptLine}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            MinWidth="104"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                            <Button
                                                Style="{StaticResource GptSoVitsActionButtonStyle}"
                                                Click="SelectGptSoVitsProfile_Click"
                                                IsEnabled="{Binding CanSelect}"
                                                Tag="{Binding Id}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontSize="16" Glyph="&#xE73E;" />
                                                    <TextBlock Text="{helpers:Loc Key=AiUse}" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Style="{StaticResource GptSoVitsActionButtonStyle}"
                                                Click="EditGptSoVitsProfileListItem_Click"
                                                Tag="{Binding Id}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                                    <TextBlock Text="{helpers:Loc Key=AiEdit}" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Style="{StaticResource GptSoVitsActionButtonStyle}"
                                                Click="DeleteGptSoVitsProfileListItem_Click"
                                                Tag="{Binding Id}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                                    <TextBlock Text="{helpers:Loc Key=AiDelete}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <labs:SettingsCard
                    x:Name="ChatTtsVoiceCard"
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=ChatTtsVoiceDescription}"
                    Header="{helpers:Loc Key=ChatTtsVoice}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </labs:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ChatTtsVoice"
                        Width="420"
                        HorizontalAlignment="Right"
                        SelectionChanged="ChatTtsVoice_SelectionChanged" />
                </labs:SettingsCard>

                <labs:SettingsCard
                    MaxWidth="2000"
                    HorizontalContentAlignment="Stretch"
                    Description="{helpers:Loc Key=ChatTtsSpeakingRateDescription}"
                    Header="{helpers:Loc Key=ChatTtsSpeakingRate}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </labs:SettingsCard.HeaderIcon>
                    <Grid Width="420" HorizontalAlignment="Right" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="ChatTtsSpeakingRate"
                            Grid.Column="0"
                            Minimum="0.5"
                            Maximum="2.0"
                            StepFrequency="0.1"
                            ValueChanged="ChatTtsSpeakingRate_ValueChanged" />
                        <TextBlock
                            x:Name="ChatTtsSpeakingRateValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </labs:SettingsCard>

                <labs:SettingsCard
                    MaxWidth="2000"
                    HorizontalContentAlignment="Stretch"
                    Description="{helpers:Loc Key=ChatTtsVolumeDescription}"
                    Header="{helpers:Loc Key=ChatTtsVolume}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE995;" />
                    </labs:SettingsCard.HeaderIcon>
                    <Grid Width="420" HorizontalAlignment="Right" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="ChatTtsVolume"
                            Grid.Column="0"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            ValueChanged="ChatTtsVolume_ValueChanged" />
                        <TextBlock
                            x:Name="ChatTtsVolumeValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </labs:SettingsCard>

                <TextBlock Margin="0,24,0,8" FontSize="20" Text="{helpers:Loc Key=ChatTtsQueueSettings}" />

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=ChatTtsQueueCapacityDescription}"
                    Header="{helpers:Loc Key=ChatTtsQueueCapacity}">
                    <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8EE;" /></labs:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="ChatTtsQueueCapacity"
                        Width="420"
                        HorizontalAlignment="Right"
                        Maximum="50"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="ChatTtsQueueCapacity_ValueChanged" />
                </labs:SettingsCard>

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=ChatTtsExpirationDescription}"
                    Header="{helpers:Loc Key=ChatTtsExpiration}">
                    <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;" /></labs:SettingsCard.HeaderIcon>
                    <StackPanel Width="420" HorizontalAlignment="Right" Spacing="8">
                        <ComboBox
                            x:Name="ChatTtsExpirationMode"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="ChatTtsExpirationMode_SelectionChanged">
                            <ComboBoxItem Content="{helpers:Loc Key=ChatTtsExpirationNever}" Tag="Never" />
                            <ComboBoxItem Content="{helpers:Loc Key=ChatTtsExpirationSeconds}" Tag="Seconds" />
                        </ComboBox>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="ChatTtsExpirationSeconds"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Maximum="300"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="ChatTtsExpirationSeconds_ValueChanged" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{helpers:Loc Key=ChatTtsSecondsUnit}" />
                        </Grid>
                    </StackPanel>
                </labs:SettingsCard>

                <TextBlock Margin="0,24,0,8" FontSize="20" Text="{helpers:Loc Key=ChatTtsMessageTypes}" />
                <TextBlock Margin="0,0,0,10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{helpers:Loc Key=ChatTtsMessageTypesDescription}" TextWrapping="Wrap" />

                <labs:SettingsCard MaxWidth="2000" Description="{helpers:Loc Key=ChatTtsSpeakAllyDescription}" Header="{helpers:Loc Key=ChatTtsSpeakAlly}">
                    <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE716;" /></labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ChatTtsSpeakAlly" Toggled="ChatTtsMessageType_Toggled" Tag="Ally" />
                </labs:SettingsCard>

                <labs:SettingsCard MaxWidth="2000" Description="{helpers:Loc Key=ChatTtsSpeakEnemyDescription}" Header="{helpers:Loc Key=ChatTtsSpeakEnemy}">
                    <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7BA;" /></labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ChatTtsSpeakEnemy" Toggled="ChatTtsMessageType_Toggled" Tag="Enemy" />
                </labs:SettingsCard>

                <labs:SettingsCard MaxWidth="2000" Description="{helpers:Loc Key=ChatTtsSpeakSystemDescription}" Header="{helpers:Loc Key=ChatTtsSpeakSystem}">
                    <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="ChatTtsSpeakSystem" Toggled="ChatTtsMessageType_Toggled" Tag="System" />
                </labs:SettingsCard>

                <TextBlock Margin="0,24,0,8" FontSize="20" Text="{helpers:Loc Key=ChatTtsPreview}" />

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=ChatTtsPreviewDescription}"
                    Header="{helpers:Loc Key=ChatTtsPreview}">
                    <labs:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE768;" /></labs:SettingsCard.HeaderIcon>
                    <Grid Width="420" HorizontalAlignment="Right" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ChatTtsPreviewText"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="{helpers:Loc Key=ChatTtsPreviewPlaceholder}" />
                        <Button
                            x:Name="ChatTtsPreviewButton"
                            Grid.Column="1"
                            Click="ChatTtsPreviewButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" />
                                <TextBlock Text="{helpers:Loc Key=ChatTtsPreviewButton}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </labs:SettingsCard>

                <InfoBar
                    x:Name="ChatTtsPreviewInfoBar"
                    Margin="0,8,0,0"
                    IsClosable="True"
                    IsOpen="False" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
