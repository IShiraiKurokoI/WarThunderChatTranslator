<Page
    x:Class="WarThunderChatTranslator.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WarThunderChatTranslator.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer>
            <StackPanel Padding="20,24,20,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="40"
                            Height="40"
                            Source="ms-appx:///Assets/favicon.png" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="30"
                            Text="{helpers:Loc Key=AboutAppName}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="{x:Bind Version}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    Margin="0,10,0,10"
                    FontSize="20"
                    Text="{helpers:Loc Key=AboutAuthor}" />
                <StackPanel Margin="0,10,0,5" Orientation="Horizontal">
                    <PersonPicture
                        HorizontalAlignment="Left"
                        DisplayName="IShirai_KurokoI"
                        ProfilePicture="https://avatars.githubusercontent.com/u/73374735" />
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock
                            Margin="5,0,0,0"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="IShirai_KurokoI" />
                        <HyperlinkButton Content="{helpers:Loc Key=AboutGitHub}" NavigateUri="https://github.com/IShiraiKurokoI" />
                        <HyperlinkButton Content="{helpers:Loc Key=AboutBilibili}" NavigateUri="https://space.bilibili.com/310144483" />
                    </StackPanel>
                </StackPanel>

                <controls:SettingsCard Margin="0,4,0,0" Header="{helpers:Loc Key=AboutCopyLinkDescription}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xe72d;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="CopyLink"
                        HorizontalAlignment="Right"
                        Click="HyperlinkButton_Click"
                        Content="{helpers:Loc Key=AboutCopyLink}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    MaxWidth="2000"
                    ActionIconToolTip="{helpers:Loc Key=AboutOpenProject}"
                    Click="SettingsCard_Click"
                    Description="{helpers:Loc Key=AboutProjectDescription}"
                    Header="{helpers:Loc Key=AboutProject}"
                    IsClickEnabled="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE12B;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>

                <TeachingTip
                    x:Name="CopyTip"
                    Title="{helpers:Loc Key=AboutCopySuccess}"
                    Subtitle="{helpers:Loc Key=AboutCopySuccessDescription}"
                    Target="{x:Bind CopyLink}">
                    <TeachingTip.IconSource>
                        <SymbolIconSource Symbol="Accept" />
                    </TeachingTip.IconSource>
                </TeachingTip>

                <controls:SettingsExpander
                    MaxWidth="2000"
                    Margin="0,0,0,20"
                    Header="{helpers:Loc Key=AboutOpenSourceThanks}">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xe734;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard MaxWidth="2000">
                            <controls:SettingsCard.Description>
                                <StackPanel>
                                    <HyperlinkButton
                                        Margin="5"
                                        Content="Microsoft.Windows.SDK.BuildTools"
                                        FontSize="18"
                                        NavigateUri="https://aka.ms/WinSDKProjectURL" />
                                    <HyperlinkButton
                                        Margin="5"
                                        Content="Microsoft/WindowsAppSDK"
                                        FontSize="18"
                                        NavigateUri="https://github.com/microsoft/windowsappsdk" />
                                    <HyperlinkButton
                                        Margin="5"
                                        Content="DevWinUI"
                                        FontSize="18"
                                        NavigateUri="https://github.com/ghost1372/DevWinUI" />
                                    <HyperlinkButton
                                        Margin="5"
                                        Content="Newtonsoft/Json"
                                        FontSize="18"
                                        NavigateUri="https://www.newtonsoft.com/json" />
                                    <HyperlinkButton
                                        Margin="5"
                                        Content="NLog"
                                        FontSize="18"
                                        NavigateUri="https://nlog-project.org/" />
                                    <HyperlinkButton
                                        Margin="5"
                                        Content="GTranslate"
                                        FontSize="18"
                                        NavigateUri="https://github.com/d4n3436/GTranslate" />
                                    <HyperlinkButton
                                        Margin="5"
                                        Content="H.NotifyIcon"
                                        FontSize="18"
                                        NavigateUri="https://github.com/HavenDV/H.NotifyIcon" />
                                </StackPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
