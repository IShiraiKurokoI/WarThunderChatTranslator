<Page
    x:Class="WarThunderChatTranslator.Pages.RunSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WarThunderChatTranslator.Helpers"
    xmlns:labs="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="20,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,44,0,0"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{helpers:Loc Key=RunSettingsTitle}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="0,0,20,48">

                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="20"
                    Text="{helpers:Loc Key=StartupSettings}" />
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=StartupSettingsDescription}"
                    TextWrapping="Wrap" />

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=OpenOverlayOnStartupDescription}"
                    Header="{helpers:Loc Key=OpenOverlayOnStartup}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="OpenOverlayOnStartup" Toggled="OpenOverlayOnStartup_Toggled" />
                </labs:SettingsCard>

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=OpenDashboardOnStartupDescription}"
                    Header="{helpers:Loc Key=OpenDashboardOnStartup}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE80F;" />
                    </labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="OpenDashboardOnStartup" Toggled="OpenDashboardOnStartup_Toggled" />
                </labs:SettingsCard>

                <TextBlock
                    Margin="0,24,0,8"
                    FontSize="20"
                    Text="{helpers:Loc Key=LanAccessSettings}" />
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=LanAccessSettingsDescription}"
                    TextWrapping="Wrap" />

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=LanAuthenticationDescription}"
                    Header="{helpers:Loc Key=LanAuthentication}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="LanAuthenticationEnabled"
                        Toggled="LanAuthenticationEnabled_Toggled" />
                </labs:SettingsCard>

                <Border
                    Margin="0,0,0,4"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="180"
                            Height="180"
                            Padding="6"
                            Background="White"
                            CornerRadius="6">
                            <Image
                                x:Name="LanQrCodeImage"
                                Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="LanDashboardAddress"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Header="{helpers:Loc Key=LanDashboardAddress}"
                                    SelectionChanged="LanDashboardAddress_SelectionChanged" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,24,0,0"
                                    Click="LanAccessRefresh_Click"
                                    Content="{helpers:Loc Key=LanAccessRefresh}" />
                            </Grid>

                            <TextBlock
                                x:Name="LanDashboardUrlText"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="LanAccessCopyUrl_Click"
                                    Content="{helpers:Loc Key=LanAccessCopyUrl}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="LanTokenPanel"
                                Spacing="6"
                                Visibility="Collapsed">
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontWeight="SemiBold"
                                    Text="{helpers:Loc Key=LanAccessToken}" />
                                <TextBlock
                                    x:Name="LanAccessTokenText"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Click="LanAccessCopyToken_Click"
                                        Content="{helpers:Loc Key=LanAccessCopyToken}" />
                                    <Button
                                        Click="LanAccessRegenerateToken_Click"
                                        Content="{helpers:Loc Key=LanAccessRegenerateToken}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{helpers:Loc Key=LanQrDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="FirewallRuleCard"
                    Margin="0,0,0,4"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            VerticalAlignment="Center"
                            Glyph="&#xE83D;" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{helpers:Loc Key=FirewallAccess}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{helpers:Loc Key=FirewallAccessDescription}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="FirewallStatusText"
                                Margin="0,8,0,0"
                                FontWeight="SemiBold"
                                Text="{helpers:Loc Key=FirewallStatusChecking}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="FirewallStatusDetailText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <Button
                                x:Name="FirewallRuleButton"
                                MinWidth="190"
                                Click="FirewallRuleButton_Click"
                                HorizontalAlignment="Stretch">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <SymbolIcon x:Name="FirewallRuleButtonIcon" Symbol="Add" />
                                    <TextBlock x:Name="FirewallRuleButtonText" Text="{helpers:Loc Key=FirewallAllowButton}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="FirewallRemoveButton"
                                MinWidth="190"
                                Click="FirewallRemoveButton_Click"
                                HorizontalAlignment="Stretch"
                                Visibility="Collapsed">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="{helpers:Loc Key=FirewallRemoveButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock
                    Margin="0,24,0,8"
                    FontSize="20"
                    Text="{helpers:Loc Key=PollingSettings}" />
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=PollingSettingsDescription}"
                    TextWrapping="Wrap" />

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=GamePollingIntervalDescription}"
                    Header="{helpers:Loc Key=GamePollingInterval}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </labs:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="GamePollingInterval"
                        Width="160"
                        Maximum="60"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="GamePollingInterval_ValueChanged" />
                </labs:SettingsCard>

                <labs:SettingsCard
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=WebPollingIntervalDescription}"
                    Header="{helpers:Loc Key=WebPollingInterval}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </labs:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="WebPollingInterval"
                        Width="160"
                        Maximum="60"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="WebPollingInterval_ValueChanged" />
                </labs:SettingsCard>

                <TextBlock
                    Margin="0,6,0,24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=PollingIntervalRange}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="20"
                    Text="{helpers:Loc Key=ChatCacheSettings}" />
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{helpers:Loc Key=ChatCacheSettingsDescription}"
                    TextWrapping="Wrap" />

                <labs:SettingsCard
                    x:Name="BattleChatClearModeCard"
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=BattleChatClearModeDescription}"
                    Header="{helpers:Loc Key=BattleChatClearMode}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D4;" />
                    </labs:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="BattleChatClearMode" SelectionChanged="BattleChatClearMode_SelectionChanged">
                        <ComboBoxItem Content="{helpers:Loc Key=BattleChatClearModeNone}" Tag="None" />
                        <ComboBoxItem Content="{helpers:Loc Key=BattleChatClearModeLogical}" Tag="Logical" />
                        <ComboBoxItem Content="{helpers:Loc Key=BattleChatClearModePhysical}" Tag="Physical" />
                    </ComboBox>
                </labs:SettingsCard>

                <labs:SettingsCard
                    x:Name="PhysicalChatCacheLimitCard"
                    MaxWidth="2000"
                    Description="{helpers:Loc Key=PhysicalChatCacheLimitDescription}"
                    Header="{helpers:Loc Key=PhysicalChatCacheLimit}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" />
                    </labs:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="PhysicalChatCacheLimit"
                        Width="160"
                        Maximum="5000"
                        Minimum="50"
                        SmallChange="50"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="PhysicalChatCacheLimit_ValueChanged" />
                </labs:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
