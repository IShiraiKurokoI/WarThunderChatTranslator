<Page
    x:Class="WarThunderChatTranslator.Pages.UpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DevWinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:WarThunderChatTranslator.Helpers"
    xmlns:local="using:WarThunderChatTranslator.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <Grid Padding="20,0,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Header"
            Margin="0,44,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutomationProperties.HeadingLevel="1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{helpers:Loc Key=UpdateTitle}" />

        <ScrollViewer Grid.Row="1">
            <Grid Padding="0,0,20,48" RowSpacing="0">

                <ContentPresenter
                    x:Name="ModuleContentPresenter"
                    Grid.Row="1"
                    Margin="0,8,0,0">
                    <ContentPresenter.Content>
                        <StackPanel>
                            <controls:SettingsCard Header="{x:Bind Version}" HeaderIcon="{controls:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE895;}">
                                <controls:SettingsCard.Description>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                            <Run Text="{helpers:Loc Key=UpdateLastChecked}" />
                                            <Run x:Name="LastUpdateCheckDate" Text="" />
                                        </TextBlock>
                                        <HyperlinkButton
                                            Margin="0,2,0,0"
                                            Content="{helpers:Loc Key=UpdateReleaseNotes}"
                                            FontWeight="SemiBold"
                                            NavigateUri="https://github.com/IShiraiKurokoI/WarThunderChatTranslator/releases" />
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <ProgressRing
                                        x:Name="Checking"
                                        Width="24"
                                        Height="24"
                                        Visibility="Collapsed" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Click="Button_Click"
                                        Content="{helpers:Loc Key=UpdateCheck}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </StackPanel>
                    </ContentPresenter.Content>
                </ContentPresenter>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
